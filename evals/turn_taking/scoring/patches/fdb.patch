@@ -0,0 +1,99 @@
+"""Helpers added by the turn-taking scoring patch (not part of upstream Full-Duplex-Bench).
+
+* judge_chat(): one entry point for every LLM-judge call (OpenAI or Anthropic).
+* judges_disabled(): FDB_SKIP_JUDGE=1 turns every judge off (no key needed).
+* dump_per_sample(): write per-sample results as JSON instead of scraping stdout.
+* FDB_JUDGE_USAGE_LOG=<file>: judge_chat() appends one JSON line of token usage per call.
+"""
+
+import json
+import os
+
+MAX_JUDGE_ATTEMPTS = 3
+
+
+def judges_disabled() -> bool:
+    return os.environ.get("FDB_SKIP_JUDGE", "") not in ("", "0", "false", "False")
+
+
+def judge_provider() -> str:
+    return os.environ.get("FDB_JUDGE_PROVIDER", "openai").strip().lower() or "openai"
+
+
+def judge_model(default_model: str) -> str:
+    return os.environ.get("FDB_JUDGE_MODEL", "").strip() or default_model
+
+
+def _log_usage(model, input_tokens, output_tokens) -> None:
+    path = os.environ.get("FDB_JUDGE_USAGE_LOG", "")
+    if not path:
+        return
+    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
+    with open(path, "a") as f:
+        f.write(
+            json.dumps(
+                {"model": model, "input_tokens": input_tokens or 0, "output_tokens": output_tokens or 0}
+            )
+            + "\n"
+        )
+
+
+def judge_chat(system_msg, user_msg, default_model, client=None, seed=0, max_tokens=2048):
+    """Return the judge's text reply.
+
+    FDB_JUDGE_PROVIDER=openai (default): upstream behaviour, chat.completions with
+    `seed`, model = FDB_JUDGE_MODEL or `default_model` (the upstream model).
+    FDB_JUDGE_PROVIDER=anthropic: messages API, model passed through unchanged,
+    no temperature override (same as upstream, which uses the API default).
+    """
+    provider = judge_provider()
+    model = judge_model(default_model)
+    if provider == "anthropic":
+        import anthropic
+
+        ac = anthropic.Anthropic()  # reads ANTHROPIC_API_KEY
+        resp = ac.messages.create(
+            model=model,
+            max_tokens=max_tokens,
+            system=system_msg,
+            messages=[{"role": "user", "content": user_msg}],
+        )
+        usage = getattr(resp, "usage", None)
+        _log_usage(
+            model, getattr(usage, "input_tokens", 0), getattr(usage, "output_tokens", 0)
+        )
+        return "".join(b.text for b in resp.content if getattr(b, "type", "") == "text")
+    if provider != "openai":
+        raise ValueError(f"FDB_JUDGE_PROVIDER must be openai|anthropic, got {provider!r}")
+    if client is None:
+        from openai import OpenAI
+
+        client = OpenAI()
+    response = client.chat.completions.create(
+        model=model,
+        messages=[
+            {"role": "system", "content": system_msg},
+            {"role": "user", "content": user_msg},
+        ],
+        seed=seed,
+    )
+    usage = getattr(response, "usage", None)
+    _log_usage(
+        model, getattr(usage, "prompt_tokens", 0), getattr(usage, "completion_tokens", 0)
+    )
+    return response.choices[0].message.content
+
+
+def pick_device() -> str:
+    """cuda if available else cpu. MPS is deliberately never used."""
+    import torch
+
+    return "cuda" if torch.cuda.is_available() else "cpu"
+
+
+def dump_per_sample(task: str, root_dir: str, payload) -> None:
+    """Write per_sample_<task>.json into $FDB_PER_SAMPLE_DIR (default: root_dir)."""
+    out_dir = os.environ.get("FDB_PER_SAMPLE_DIR") or root_dir
+    os.makedirs(out_dir, exist_ok=True)
+    with open(os.path.join(out_dir, f"per_sample_{task}.json"), "w") as f:
+        json.dump(payload, f, indent=2)
