#. Translators: CLDR date pattern with year; quote literal words: 'de'.
msgctxt "date pattern with year"
msgid "EEEE, MMMM d, y"
msgstr "EEEE d 'de' MMMM 'de' y"

#. Translators: CLDR date pattern; quote literal words: 'de'.
msgctxt "date pattern"
msgid "EEEE, MMMM d"
msgstr "EEEE d 'de' MMMM"

#. Translators: CLDR time pattern: h is the 12-hour clock, H the 24-hour one, a
#. AM/PM.
msgctxt "time pattern"
msgid "h:mm a"
msgstr "H:mm"

#. Translators: a time of day. The plural form follows the hour on a 24-hour
#. clock
#. (Spanish: "a la 1:00" against "a las 17:00"). {time} is the formatted time.
#, python-brace-format
msgid "at {time}"
msgid_plural "at {time}"
msgstr[0] "a la {time}"
msgstr[1] "a las {time}"

msgid "online, by video call"
msgstr "online, por videollamada"

#, python-brace-format
msgid "our office in {address}"
msgstr "en nuestra oficina de {address}"

msgid "our office"
msgstr "en nuestra oficina"

msgid ""
"I'm sorry, we're having a technical problem right now. We'll call you "
"again later. Goodbye!"
msgstr ""
"Lo siento, ahora mismo tenemos un problema técnico. Te llamaremos más "
"tarde. ¡Hasta luego!"

msgid "Sorry, I'm having a technical problem. We'll call you back shortly."
msgstr ""
"Perdona, estoy teniendo un problema técnico. Te volvemos a llamar en un "
"rato."

msgid "Let me check that."
msgstr "Déjame comprobarlo."

msgid ""
"The candidate was already screened and no questions were asked. Read the "
"transcript and notes: contact them if they asked to reschedule or cancel."
msgstr ""
"El candidato ya había pasado la preselección y no se le hicieron "
"preguntas. Leer la transcripción y las notas: contactarle si pidió "
"cambiar o cancelar su cita."

msgid ""
"Review the recorded facts and the transcript; no automatic summary was "
"available."
msgstr ""
"Revisar los datos registrados y la transcripción; no hubo resumen "
"automático."

#. Translators: the word before the last item of a list.
msgctxt "list conjunction"
msgid "and"
msgstr "y"

#. Translators: the same word before an item that starts with an /i/ sound,
#. where the
#. language changes it (Spanish "y" becomes "e": "física e informática").
msgctxt "list conjunction before an i sound"
msgid "and"
msgstr "e"

