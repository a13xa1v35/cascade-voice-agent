# Copy to .env and fill in. Only the keys for the providers you select are needed.
# Quickest start for voice: keep the defaults (Anthropic + AssemblyAI) and set ANTHROPIC_API_KEY,
# ASSEMBLYAI_API_KEY and the two Cloudflare keys (turn-taking). `make chat` needs only
# ANTHROPIC_API_KEY.

# --- Providers -------------------------------------------------------------------
LLM_PROVIDER=anthropic           # anthropic | openai (Sofia's model only; the summary is always Anthropic)
STT_PROVIDER=assemblyai          # assemblyai | deepgram
TTS_PROVIDER=assemblyai          # assemblyai | cartesia | elevenlabs

# --- API keys --------------------------------------------------------------------
ANTHROPIC_API_KEY=               # also needed with LLM_PROVIDER=openai while SUMMARY_ENABLED=true
ASSEMBLYAI_API_KEY=              # one key covers AssemblyAI STT and TTS
DEEPGRAM_API_KEY=                # needed when STT_PROVIDER=deepgram
CARTESIA_API_KEY=                # needed when TTS_PROVIDER=cartesia
ELEVENLABS_API_KEY=              # needed when TTS_PROVIDER=elevenlabs
# Required for voice calls (web and phone): the turn-taking model runs on Cloudflare Workers
# AI, so the API token needs the Workers AI permission. The text channel (`make chat`) does
# not need these two.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Turn taking -----------------------------------------------------------------------
# There is one design and no switches: a small decision model (Cloudflare Workers AI, the
# two keys above) judges the streaming transcript (src/hr_screener/turn_taking/design.py).
# Benchmark history: evals/turn_taking/reports/SUMMARY.md. The questions to that model are
# English for every call, like the prompt; the stop words follow LANGUAGE.

# --- In-call frustration check -----------------------------------------------------
# After a candidate turn, the same Cloudflare model is asked whether the candidate is frustrated
# with the call (src/hr_screener/pipeline/frustration.py). Recorded per call (events, scorecard,
# call_metrics). Needs the two Cloudflare keys, otherwise it is silently off
# (so `make chat` works with only ANTHROPIC_API_KEY). Applies to voice and text.
FRUSTRATION_CHECK_ENABLED=true
FRUSTRATION_MIN_GAP_SECS=3       # at most one request in flight; this long between two starts
# Tell Sofia with a short note (one turn late) when the candidate becomes frustrated. Off by
# default: the check still runs and records. Needs the check to run (Cloudflare keys).
FRUSTRATION_NOTES_ENABLED=false

# --- Models and voices -------------------------------------------------------------
# claude-haiku-5-5 (default; lowest latency and cost) | claude-sonnet-5-5 (middle ground)
# claude-opus-5-5 (strongest; pipecat sends effort=low automatically for voice latency)
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_PROMPT_CACHING=true    # cache Sofia's system prompt + tools across the requests of a call
# Lifetime of the cache entry for the part of the prompt shared by every call (tools + fixed prompt): 5m or 1h.
# 1h costs 2x to write (5m: 1.25x), so it only pays off when calls are more than 5 minutes apart.
ANTHROPIC_FIXED_PROMPT_CACHE_TTL=5m
# Used when LLM_PROVIDER=openai (key: OPENAI_API_KEY, shared with embeddings). Keep it a non-reasoning model: a voice turn has no time for
# hidden thinking tokens.
OPENAI_MODEL=gpt-4.1-mini
ASSEMBLYAI_VOICE_ID=             # English voice. Empty = default voice; or an id like aai-jane
# Spanish voice. All documented AssemblyAI Spanish voices are Mexican Spanish:
# aai-antonioluis (male), aai-constanza (f), aai-malvina (f), aai-oriol (male).
ASSEMBLYAI_VOICE_ID_ES=aai-constanza
CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Sofia's LLM requests: rate limit ----------------------------------
# Client-side limit for quota-limited keys (free tiers, shared quotas) and the eval; 0 = off.
# Every request waits until it fits in a sliding 60 s window, so a live call can go quiet for
# longer when the quota is the bottleneck. Per process (several instances sharing a quota would
# need a shared limiter). LLM_MAX_TPM counts input tokens, estimated at ~4 characters each:
# set both a bit under the provider's limits.
LLM_MAX_RPM=0                    # requests per minute
LLM_MAX_TPM=0                    # input tokens per minute
# Re-send a request whose answer has not started after this many seconds (once; 0 = off).
# Haiku answers in ~1 s. A slower healthy model gets re-sent too, so raise it if token cost
# matters more than latency.
LLM_FIRST_CHUNK_TIMEOUT_SECS=5.0

# --- Storage -----------------------------------------------------------------------
# System of record. SQLite by default; Postgres: postgresql+asyncpg://user:pass@host/db
# (and install asyncpg). Create the schema with `make migrate`.
DATABASE_URL=sqlite+aiosqlite:///./var/hr_screener.storage.db
# Redis holds only the per-call event timeline (telemetry, not a record).
REDIS_URL=redis://localhost:6379/0
# The event timeline of a call expires this many days after its last flush. The scalar
# scorecard and the tool calls stay in the database.
EVENTS_TTL_DAYS=30                # 0 = never expire

# --- Twilio (phone channel only) -----------------------------------------------------
# Public https URL that reaches this server, e.g. your ngrok URL (no trailing slash).
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=               # also used to validate webhook signatures
TWILIO_FROM_NUMBER=              # your Twilio number in E.164, e.g. +15551234567

# --- Public demo (Fly.io) ------------------------------------------------------------
DEMO_PASSWORD=                   # admin HTTP Basic password (any username) for the REST API, /docs and /client. The demo pages (/, /demo) stay public. Empty = no gate
DEMO_ACCESS_CODES=               # comma-separated codes the demo needs to start a call (and show its results); empty = nobody can call
DEMO_AUTHOR_NAME=Alex Alves      # "Built by ..." on the home page
DEMO_GITHUB_URL=                 # home page links; empty hides the link
DEMO_LINKEDIN_URL=
WEB_UI_ENABLED=true              # false = phone only: no /client, no WebRTC routes; / serves the demo page (always at /demo)
DEMO_MAX_CALLS_PER_DAY=20        # phone calls POST /demo/call may start per 24 h; 0 = unlimited
CALL_TIME_LIMIT_SECS=900         # Twilio ends every phone call after this long

# --- Language ----------------------------------------------------------------------
# en | es: language of the call (STT, TTS, spoken dates and places, summary). The prompt and
# tools the model reads are English whatever it is.
LANGUAGE=en

# --- Business defaults (openings, with their role, location, needed subjects and start
# window, live in the database; `make seed` creates a demo one) --------------------------
AGENCY_NAME=TuTeacher
AGENT_NAME=Sofia
COUNTRY=Spain
TIMEZONE=Europe/Madrid           # slot times are read aloud in this zone
FOLLOWUP_RECENT_MINUTES=30       # a follow-up this soon after the earlier call skips "is now a good time?"
DEMO_CANDIDATE_ID=               # optional; web UI / make chat default. Empty or unknown in this database = most recent candidate
DEMO_CANDIDATE_PHONE=+15555550100  # phone number the seed script gives the demo candidate

# --- Observability ---------------------------------------------------------------------
# Per-turn latency breakdowns and turn/interruption logs are always on.
# true = also log transcripts, LLM requests/responses, tool-call steps and service metrics.
DEBUG_PIPELINE=false

# --- Server --------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=7860

# --- Hang-up safety ------------------------------------------------------------------------
# Seconds to wait after the goodbye finished playing before hanging up. If the candidate
# starts speaking in that window the hang-up is cancelled and the conversation continues.
HANGUP_GRACE_SECS=3.0

# --- Dead-connection handling ----------------------------------------------------------------
# Browser calls: end the call (end reason connection_lost) when no audio frame has arrived
# for this many seconds after the client was ready. 0 disables the watchdog.
AUDIO_LOST_SECS=5.0
# A new call for a candidate ends their still-running call first (end reason superseded).
# Seconds to wait for the old call to write its final status before closing it by force.
SUPERSEDE_WAIT_SECS=5.0

# --- Post-call summary ------------------------------------------------------------------
SUMMARY_ENABLED=true             # false = skip the LLM summary and use the facts-based fallback
SUMMARY_MODEL=claude-sonnet-5-5  # post-call summary model (off the latency path); empty = ANTHROPIC_MODEL

# --- Eval harness (make eval-e2e; see evals/README.md) -----------------------------------
# Redis the evals use for call event timelines. Must differ from REDIS_URL; the keys they
# create are deleted at the end. The evals never touch DATABASE_URL: each conversation gets
# its own SQLite file under evals/results/<suite>/.
# EVAL_REDIS_URL=redis://localhost:6379/15

# --- Knowledge base (RAG; design in the README) --------------------------------------------
# Markdown documents (Spanish) split into chunks, embedded and stored in Qdrant. `make ingest`
# syncs them by hand (stop the server first when Qdrant is embedded); the server also syncs at
# startup when KB_SYNC_ON_STARTUP=true.
KB_DIR=knowledge
KB_LANGUAGE=es                   # es or en: BM25 stemmer, and the language search queries are written in
# Qdrant: embedded in this folder (one process only). Set QDRANT_URL to use a server or Qdrant
# Cloud instead (the path is then ignored).
QDRANT_PATH=var/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
# Dense embeddings: openai (needs OPENAI_API_KEY; without it the knowledge base is unavailable
# and the server still starts), voyage (needs VOYAGE_API_KEY) or local (fastembed multilingual
# model, no network). Changing the provider, model or dimension means a full re-ingest.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=                  # embeddings, and Sofia when LLM_PROVIDER=openai (one shared key)
# VOYAGE_API_KEY=
# Empty = the provider's default: text-embedding-3-large (openai), voyage-4-lite (voyage).
EMBEDDING_MODEL=
EMBEDDING_DIM=1024               # openai / voyage output dimension (the local model is fixed at 384)
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_DIR=var/fastembed  # where fastembed keeps the BM25 (and local) models
KB_TOP_K=4                       # chunks returned to the model
KB_MIN_SCORE=0.45                # best dense cosine below this = no match (tuned by make eval-kb for text-embedding-3-large)
KB_TIMEOUT_SECS=5                # deadline for one lookup (query embedding + search)
KB_TOOL_TIMEOUT_SECS=8           # Pipecat backstop around the whole tool call
KB_SYNC_ON_STARTUP=true          # sync KB_DIR into Qdrant before accepting calls
